# Copia questo file in .env (che e' in .gitignore) per provare il bot in locale.
# Il token lo da' @BotFather; la chat id si legge da
# https://api.telegram.org/bot<TOKEN>/getUpdates dopo aver scritto al bot.
TELEGRAM_BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample
TELEGRAM_CHAT_ID=123456789
